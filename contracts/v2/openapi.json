  "components": {
    "schemas": {
      "ClaimRequest": {
        "properties": {
          "join_code": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Join Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "join_code"
        ],
        "title": "ClaimRequest"
      },
      "Command": {
        "properties": {
          "api_version": {
            "type": "string",
            "const": "2.0",
            "title": "Api Version",
            "default": "2.0"
          },
          "command_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Command Id"
          },
          "run_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Run Id"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "command_id",
          "run_id",
          "expected_revision",
          "payload"
        ],
        "title": "Command"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Lease": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "acquire",
              "renew",
              "release"
            ],
            "title": "Action",
            "default": "acquire"
          },
          "takeover": {
            "type": "boolean",
            "title": "Takeover",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Lease"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}